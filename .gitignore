# Compilados y artefactos de build
target/
.flattened-pom.xml
.mvn/timeline.properties

# Logs de ejecucion. Los *.log del proyecto son de corridas locales, no del codigo.
*.log
logs/

# Lo mismo que *.log pero para la salida de error. Aparece sola al arrancar el jar
# con Start-Process -RedirectStandardError, que es la unica forma de levantarlo en
# una maquina donde java no esta en el PATH.
*.err

# .settings/ .classpath .project NO van aqui a proposito: estan trackeados desde
# el origen porque el proyecto se abre con Eclipse y forman parte de su config.
# Si algun dia se decide dejar de trackearlos, se borran con git rm --cached.

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Locales / secretos
*.env
.env.local
